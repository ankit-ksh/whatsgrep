{
  "name": "whatsgrep",
  "version": "0.2.1",
  "description": "Watch the WhatsApp chats and email you choose for rules you write and get alerted on your desktop or phone. Ships as one executable for Windows, macOS and Linux.",
  "type": "module",
  "bin": {
    "whatsgrep": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "build": "node scripts/build.js",
    "typecheck": "tsc -p src/ui --noEmit",
    "phone-app": "node scripts/serve-app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dbus-next": "^0.10.2",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "whatsapp-web.js": "^1.26.0",
    "yaml": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankit-ksh/whatsgrep.git"
  },
  "homepage": "https://github.com/ankit-ksh/whatsgrep#readme",
  "bugs": {
    "url": "https://github.com/ankit-ksh/whatsgrep/issues"
  },
  "keywords": [
    "alerts",
    "cli",
    "desktop-notifications",
    "executable",
    "keyword",
    "notifications",
    "web-push",
    "whatsapp",
    "whatsapp-web.js"
  ],
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.10",
    "hoodiecrow-imap": "^3.3.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "config.example.yaml",
    "LICENSE",
    "README.md"
  ]
}
